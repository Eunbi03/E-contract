                                </div>
                                <input type="text" name="probationSalary" className="w-full p-2 border text-sm" value={formData.probationSalary} onChange={handleChange} placeholder="수습급여 (예: 2,000,000)"/>
                            </div>
                        )}
                    </div>
                  </div>

                  {/* 3. 근무장소 및 업무 */}
