                              <label className="text-gray-600 text-xs block mb-1 font-bold">1일 근로시간</label>
                              <div className="flex items-center gap-1">
                                <input type="number" name="dailyWorkHours" className="w-full p-2 border rounded text-right font-bold" value={formData.dailyWorkHours} onChange={handleChange}/>
                                <span className="text-sm shrink-0">시간</span> 
                              </div>
                            </div>
                            <div className="flex-1">
                              <label className="text-gray-600 text-xs block mb-1 font-bold">주 근무일수</label>
