            {workerStep >= 7 && workerStep < 10 && (<button onClick={() => saveSignatureAndNext(`sign${workerStep - 6}`)} className="py-5 flex-[2] bg-green-600 text-white font-bold rounded-lg shadow-lg text-lg hover:bg-green-700 flex justify-center items-center gap-2">서명 저장 후 다음 <ChevronRight className="ml-2"/></button>)}
            {workerStep === 10 && (<button onClick={finalSubmit} className="py-5 flex-[2] bg-blue-600 text-white font-bold rounded-lg shadow-lg text-lg hover:bg-blue-700 flex justify-center items-center gap-2">최종 제출 및 완료</button>)}
          </div>
        </div>
