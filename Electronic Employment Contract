                    <div className="flex gap-2 mb-2">
                        <input type="text" name="workPlace" className="w-1/2 p-2 border rounded" value={formData.workPlace} onChange={handleChange} placeholder="근무장소"/>
                        <select name="dutiesSelect" className="w-1/2 p-2 border rounded" value={formData.isDirectDuties ? '직접입력' : formData.duties} onChange={handleChange}>
                            <option value="사무직">사무직</option><option value="영업직">영업직</option><option value="생산직">생산직</option><option value="직접입력">직접입력</option>
                        </select>
                    </div>
                    {formData.isDirectDuties && <input type="text" name="dutiesDirect" className="w-full p-2 border rounded" value={formData.dutiesDirect} onChange={handleChange} placeholder="담당업무 입력" />}
                  </div>

                  {/* 4. 근로시간 및 휴게시간 */}
                  <div className="border-t pt-4">
                    <h3 className="font-bold text-gray-800 mb-2">2. 근로/휴게시간</h3>
                    <div className="bg-blue-50 p-4 rounded border border-blue-200 space-y-4">
                      {!formData.isBiweekly ? (
