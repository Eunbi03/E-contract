                                <input type="number" name="weeklyWorkDays" className="w-full p-2 border rounded text-right font-bold" value={formData.weeklyWorkDays} onChange={handleChange}/>
                                <span className="text-sm shrink-0">일</span>
                              </div>
                            </div>
                          </div>

                          {/* (시업 ~ 종업) */}
