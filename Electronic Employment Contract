                    <span className="mr-4">("갑")</span> 
                    <span className="mr-2">{formData.companyName}</span> 
                    <span className="mr-2">대표이사</span> 
                    <span className="mr-2">{formData.repName}</span> 
                    <span className="text-gray-400">(인)</span>
                    {contractStatus === 'COMPLETED' && sealImages[formData.companyName] && (
                      <img src={sealImages[formData.companyName]} className="absolute -top-4 -right-8 w-18 h-18 mix-blend-multiply opacity-80" alt="직인" />
                    )}
                  </div>
                  <div className="text-right relative mt-8">
                    <span className="mr-4 font-bold">("을")</span>
                    <span className="mr-2">성 명 :</span>
                    <span className="mr-4 inline-block min-w-[80px] text-center border-b border-black font-bold">{formData.empName}</span>
                    <span className="text-gray-400 text-sm relative inline-block mr-4">(서명 또는 인)
                      {signatures.sign4 && <img src={signatures.sign4} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-28 h-auto max-w-none object-contain mix-blend-multiply" alt="최종서명"/>}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ⭐ 근로자 전송 완료&최종 계약 완료*/}
        {step === 3 && (contractStatus === 'COMPLETED' || (!isManagerView && contractStatus === 'SIGNED_BY_WORKER')) && (
            <div className="w-full min-h-screen bg-gray-100 flex flex-col justify-center items-center p-6 z-10 text-center print:hidden">
                {contractStatus === 'COMPLETED' ? (
                    <div className="flex flex-col items-center w-full max-w-sm">
                      <CheckCircle className="w-16 h-16 text-green-500 mb-4"/>
                      <h2 className="text-2xl font-bold text-gray-800 mb-2">계약 완료</h2>
                      <p className="text-gray-500 mb-6 break-keep">최종 승인 및 직인 날인이 완료되었습니다.</p>
                      <button onClick={()=>{const isWebView = /KAKAOTALK|NAVER|Daum|Instagram|Line/i.test(navigator.userAgent);
                        if (isWebView) { alert("현재 사용 중인 메일 앱 내부에서는 PDF 저장이 차단되어 있습니다.\n다른 브라우저(Safari, Chrome)를 이용해 주세요."); }
                        window.print();}}
                        className="w-full px-6 py-4 bg-gray-800 text-white rounded-lg font-bold hover:bg-gray-900 shadow-lg text-lg">
                          <Printer className="inline mr-2"/> PDF 저장
                      </button>
                    </div>
                ) : (
                    <div className="flex flex-col items-center w-full max-w-sm">
                        <div className="mb-4 bg-yellow-100 p-4 rounded-full"><Lock className="w-10 h-10 text-yellow-600"/></div>
                        <h2 className="text-2xl font-bold text-gray-800 mb-2">전송 완료</h2>
                        <p className="text-gray-500 font-bold mb-2">담당자에게 서명된 계약서가 전달되었습니다.</p>
                        <p className="text-sm text-gray-400">최종 승인 및 직인 날인이 끝나면 완료 링크를 문자 또는 메일로 보내드립니다.</p>
                    </div>
                )}
            </div>
        )}
      </div>
    </div>
  );
};

ReactDOM.render(<App />, document.getElementById('root'));
</script>
</body>
</html>
