<body>
<input type="hidden" id="data-contract-id" value="<?= contractId ?>" />
<input type="hidden" id="data-view-mode" value="<?= viewMode ?>" />
<div id="root"></div>

<script type="text/babel">
  const { useState, useRef, useEffect } = React;

  // 아이콘
  const IconBase = ({ children, className }) => (<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={`inline-block ${className || ''}`}>{children}</svg>);
  const Lock = ({ className }) => <IconBase className={className}><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></IconBase>;
  const CheckCircle = ({ className }) => <IconBase className={className}><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></IconBase>;
  const PenTool = ({ className }) => <IconBase className={className}><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></IconBase>;
  const Send = ({ className }) => <IconBase className={className}><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></IconBase>;
  const Printer = ({ className }) => <IconBase className={className}><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2-2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></IconBase>;
  const Eraser = ({ className }) => <IconBase className={className}><path d="M2.9 15.8a1 1 0 0 0-.9 1.2l2.5 9A1 1 0 0 0 5.6 27h12.8a1 1 0 0 0 1-1l2.5-9a1 1 0 0 0-.9-1.2c-1.1-.3-2.3-.5-3.5-.5s-2.4.2-3.5.5c-1.1.3-2.3.5-3.5.5s-2.4-.2-3.5-.5z" transform="translate(-2 -2) scale(0.9)"/></IconBase>;
  const ChevronRight = ({ className }) => <IconBase className={className}><polyline points="9 18 15 12 9 6"></polyline></IconBase>;

  const App = () => {

   // 직인 이미지 불러오기
   const sealImages = window.sealImages || {};

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 전화번호 하이픈 처리
  const autoHyphenPhone = (str) => {
    const clean = String(str).replace(/[^0-9]/g, '');
    if (clean.length <= 3) return clean;
    if (clean.startsWith('02')) {
      if (clean.length <= 5) return clean.replace(/(\d{2})(\d{1,3})/, '$1-$2');
      if (clean.length <= 9) return clean.replace(/(\d{2})(\d{3})(\d{1,4})/, '$1-$2-$3');
      return clean.replace(/(\d{2})(\d{4})(\d{1,4})/, '$1-$2-$3');
    } else {
      if (clean.length <= 7) return clean.replace(/(\d{3})(\d{1,4})/, '$1-$2');
      if (clean.length <= 10) return clean.replace(/(\d{3})(\d{3})(\d{1,4})/, '$1-$2-$3');
      return clean.replace(/(\d{3})(\d{4})(\d{1,4})/, '$1-$2-$3');
    }
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 주민등록번호 하이픈 처리
  const autoHyphenRegNum = (str) => {
    const clean = String(str).replace(/[^0-9]/g, '');
    if (clean.length <= 6) return clean;
    return clean.replace(/(\d{6})(\d{1,7})/, '$1-$2').slice(0, 14);
  };

  // ⭐ 법인별 정보
  const companies = [ 
    { name: '(주)케이프라이드', address: '강원도 횡성군 우천면 우천제2농공단지로 65-50', phone: 'T. 033-644-4467 F.033-644-1944', rep: '김도영', managerPhone: '033-340-0023', managerEmail: 'kpride@example.com', managerName: '송문주'},
    { name: '㈜케이펙', address: '강원도 강릉시 정원로 54, 8층(교동, 주니어타운)', phone: 'T. 033-644-4467 F.033-644-1944', rep: '김도영', managerPhone: '033-340-0012', managerEmail: 'kpride@example.com', managerName: '하주연' },
    { name: '백두대간영농조합법인', address: '강원도 강릉시 정원로 54, 8층(교동, 주니어타운)', phone: 'T. 033-644-4467 F.033-644-1944', rep: '김도영', managerPhone: '033-340-0021', managerEmail: 'kpride@example.com', managerName: '서영민' },
    { name: '㈜보담', address: '강원도 원주시 저금어지길 456(가현동 강원LPC 2층)', phone: 'T. 033-644-4467 F.033-644-1944', rep: '이승수', managerPhone: '033-340-0020', managerEmail: 'kpride@example.com', managerName: '이선우' },
    { name: '(주)마시타', address: '강원도 강릉시 정원로 54, 8층(교통, 주니어타운)', phone: 'T. 033-644-4467 F.033-644-1944', rep: '김주원', managerPhone: '033-340-0023', managerEmail: 'kpride@example.com', managerName: '송문주'}
  ];

  // 4-2. formData — 계약서 핵심 데이터 (Index.html) 
  // ⭐ 계약서 초기 정보값 설정
  const [formData, setFormData] = useState({
    companyName: '(주)케이프라이드', companyAddress: '강원도 횡성군 우천면 우천제2농공단지로 65-50', companyPhone: 'T.033-644-4467 F.033-644-1944', repName: '김도영', managerPhone: '033-340-0023', managerEmail: 'kpride@example.com', managerName: '송문주',
    contractPassword: '', empName: '', empRegNumber: '', empAddress: '', empPhone: '',
    joinDate: new Date().toISOString().split('T')[0], contractType: 'regular', startDate: new Date().toISOString().split('T')[0], 
    contractMonths: '', endDate: '', 
    useProbation: false, probationStartDate: new Date().toISOString().split('T')[0], probationEndDate: '', probationMonths: '3', probationSalary: '',
    workPlace: '새말센터', duties: '사무직', dutiesDirect: '', isDirectDuties: false,
    weeklyWorkDays: '5', dailyWorkHours: '8', weeklyWorkHours: '40', 
    startTime: '08:00', endTime: '17:00', breakTimeMinutes: '60', breakTimeStart: '11:30', breakTimeEnd: '12:30'
  });

  // 4-3. 기타 UI 상태 변수 (Index.html)
  const [workerList, setWorkerList] = useState([{ name: '', password: '', email: '' }]);
  const [sendMode, setSendMode] = useState('email');
  const [step, setStep] = useState(1); 
  const [loading, setLoading] = useState(false);
  const [workerStep, setWorkerStep] = useState(1);
  const [verificationInput, setVerificationInput] = useState('');
  const [isIdentityVerified, setIsIdentityVerified] = useState(false);
  const [isWorkerInfoSubmitted, setIsWorkerInfoSubmitted] = useState(false);
  const [signatures, setSignatures] = useState({ sign1: null, sign2: null, sign3: null, sign4: null });
  const [isManagerView, setIsManagerView] = useState(false); 
  const [contractStatus, setContractStatus] = useState('DRAFT'); 
  const [urlId, setUrlId] = useState(null);
  const canvasRef = useRef(null);
  const [isDrawing, setIsDrawing] = useState(false);
  const [isInvalidLink, setIsInvalidLink] = useState(false);

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 계약일(계샨용)
  const calcEnd = (start, months) => {
    if(!start || !months) return '';
    const d = new Date(start); 
    d.setMonth(d.getMonth() + parseInt(months)); 
    d.setDate(d.getDate() - 1);
    return d.toISOString().split('T')[0];
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 계약일 표기
  const formatDate = (d) => {
    if (!d) return "      년      월      일";
    let s = d;
    if (typeof d === 'object') {
      if (d.toISOString) s = d.toISOString().split('T')[0];
      else return String(d);
    }
    const p = String(s).split('-');
    if (p.length < 3) return s;
    return `${p[0]}년 ${p[1]}월 ${p[2]}일`;
  };

  // ⭐ 기존 서명 보여주기
  useEffect(() => {
    if (workerStep >= 7 && workerStep <= 10 && canvasRef.current) {
      const canvas = canvasRef.current;
      const ctx = canvas.getContext('2d');

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      let signKey = workerStep === 10 ? 'sign4' : `sign${workerStep - 6}`;
      
      if (signatures[signKey]) {
        const img = new Image();
        img.onload = () => {
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        };
        img.src = signatures[signKey];
      }
    }
  }, [workerStep]);
  
  useEffect(() => {
    const idInput = document.getElementById('data-contract-id');
    const modeInput = document.getElementById('data-view-mode');

    const urlParams = new URLSearchParams(window.location.search);
    const id = urlParams.get('id') || (idInput ? idInput.value : null);
    const mode = urlParams.get('mode') || (modeInput ? modeInput.value : null);
    
    setUrlId(id);

    // ⭐ (근로자)접속 링크 유효성 검사
    if (id && id !== "null" && id !== "") {
      setLoading(true);
      const timeoutId = setTimeout(() => { if(loading) { setLoading(false); alert("서버 응답 지연."); } }, 8000);

      if (window.google && window.google.script) {
        if (mode === 'view') {
          setIsManagerView(true);
          google.script.run.withSuccessHandler(data => {
            clearTimeout(timeoutId); setLoading(false);
            if (data) { 
              setFormData(data); 
              setSignatures({ sign1: data.sign1, sign2: data.sign2, sign3: data.sign3, sign4: data.sign4 }); 
              setContractStatus(data.status || 'COMPLETED');
              setStep(3); 
            } else {
              alert("유효하지 않거나 삭제된 문서입니다.");
              setIsInvalidLink(true);
            }
          }).loadSignedData(id);
        } else {
          google.script.run.withSuccessHandler(data => {
            clearTimeout(timeoutId); setLoading(false);
            if (data === "ALREADY_COMPLETED") {
              setStep(3); setContractStatus('COMPLETED');
              return alert("이미 최종 완료된 계약서입니다.");
            }
            if (data) {
              setFormData({ ...data, empName: data.empName || '', empPhone: data.empPhone || data.contractPassword || '' });
              setContractStatus(data.status || 'DRAFT');
              if (data.status === 'SIGNED_BY_WORKER') {
                setSignatures({ sign1: data.sign1, sign2: data.sign2, sign3: data.sign3, sign4: data.sign4 });
                setStep(3); 
              } else {
                setStep(2); setIsIdentityVerified(false);
              }
            } else { 
              alert("유효하지 않은 링크입니다."); 
              setIsInvalidLink(true);
            }
          }).loadDraftData(id);
        }
      } else { clearTimeout(timeoutId); setLoading(false); }
    }
  }, []);

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 입력값 변경 처리 - 관리자 우측 화면
  const handleChange = (e) => {
    const { name, value, type, checked } = e.target;
    const newVal = type === 'checkbox' ? checked : value;

    if (name === 'companySelect') {
      const selected = companies.find(c => c.name === value);
      setFormData({ ...formData, companyName: selected.name, companyAddress: selected.address, companyPhone: selected.phone, repName: selected.rep, managerPhone: selected.managerPhone, managerEmail: selected.managerEmail, managerName: selected.managerName });
    } else if (name === 'joinDate') {
      let up = { ...formData, joinDate: newVal, startDate: newVal, probationStartDate: newVal };
      if(formData.probationMonths) up.probationEndDate = calcEnd(newVal, formData.probationMonths);
      if(formData.contractType === 'contract' && formData.contractMonths && formData.contractMonths !== 'direct') up.endDate = calcEnd(newVal, formData.contractMonths);
      setFormData(up);
    } else if (name === 'probationMonths') {
      setFormData({ ...formData, probationMonths: newVal, probationEndDate: calcEnd(formData.probationStartDate, newVal) });
    } else if (name === 'contractMonths') {
      if (newVal === 'direct') setFormData({ ...formData, contractMonths: newVal, endDate: '' });
      else setFormData({ ...formData, contractMonths: newVal, endDate: calcEnd(formData.startDate, newVal) });
    } else if (name === 'useProbation') {
      if (newVal) setFormData({ ...formData, useProbation: newVal, probationEndDate: calcEnd(formData.probationStartDate, formData.probationMonths) });
      else setFormData({ ...formData, useProbation: newVal });
    } else if (name === 'probationStartDate') {
      setFormData({ ...formData, probationStartDate: newVal, probationEndDate: calcEnd(newVal, formData.probationMonths) });
    } else if (name === 'empRegNumber') {
      setFormData({ ...formData, [name]: autoHyphenRegNum(newVal) });
    } else if (name === 'empPhone') {
      setFormData({ ...formData, [name]: autoHyphenPhone(newVal) });
    } else if (name === 'dutiesSelect') {
      if (newVal === '직접입력') setFormData({ ...formData, isDirectDuties: true, duties: formData.dutiesDirect });
      else setFormData({ ...formData, isDirectDuties: false, duties: newVal });
    } else if (name === 'dutiesDirect') {
      setFormData({ ...formData, dutiesDirect: newVal, duties: newVal });
    } else if (name === 'dailyWorkHours' || name === 'weeklyWorkDays') {
        const daily = name === 'dailyWorkHours' ? parseFloat(newVal || 0) : parseFloat(formData.dailyWorkHours || 0);
        const days = name === 'weeklyWorkDays' ? parseFloat(newVal || 0) : parseFloat(formData.weeklyWorkDays || 0);
        const autoWeekly = (daily * days);
        setFormData({ ...formData, [name]: newVal, weeklyWorkHours: String(autoWeekly) });
    } else {
      setFormData({ ...formData, [name]: newVal });
    }
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ (관리자)근로자 발송 정보 입력 여부 & 발송 완료
  const handleSend = () => {
    for (let i = 0; i < workerList.length; i++) {
      const w = workerList[i];
      if (!w.name.trim()) {
        return alert(`${i + 1}번째 근로자의 성명을 입력해 주세요.`);
      }
      if (!w.password.trim()) {
        return alert(`${i + 1}번째 근로자의 전화번호를 입력해 주세요.`);
      }
      if (sendMode === 'email' && !w.email.trim()) {
        return alert(`${i + 1}번째 근로자의 이메일을 입력해 주세요.`);
      }
    }

    if(!confirm("발송하시겠습니까?")) return;
    setLoading(true);
    google.script.run.withSuccessHandler(res => {
      setLoading(false); alert("발송 완료!");
    }).sendBatchContracts({ ...formData, sendMode }, workerList);
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ (근로자)본인인증 확인
  const checkPw = () => {
    const cleanInput = verificationInput.replace(/[^0-9]/g, '');
    const cleanStored = formData.contractPassword.replace(/[^0-9]/g, '');
    if (cleanInput === cleanStored) { setIsIdentityVerified(true); } 
    else alert("비밀번호 불일치");
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ (근로자)정보 입력 확인
  const submitWorkerInfo = () => {
    if(!formData.empName || !formData.empRegNumber || !formData.empAddress || !formData.empPhone) return alert("모든 정보를 입력해주세요.");
    setIsWorkerInfoSubmitted(true);
  };
  
  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 서명 시작점 확인
  const startDraw = (e) => { 
    const ctx = canvasRef.current.getContext('2d'); 
    ctx.lineWidth = 5;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = 'black';
    
    const rect = canvasRef.current.getBoundingClientRect(); 
    const x = (e.clientX||e.touches[0].clientX) - rect.left; 
    const y = (e.clientY||e.touches[0].clientY) - rect.top; 
    ctx.beginPath(); ctx.moveTo(x,y); setIsDrawing(true); 
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 서명 그리기
  const moveDraw = (e) => { 
    if(!isDrawing) return; 
    const ctx = canvasRef.current.getContext('2d'); 
    const rect = canvasRef.current.getBoundingClientRect(); 
    const x = (e.clientX||e.touches[0].clientX) - rect.left; 
    const y = (e.clientY||e.touches[0].clientY) - rect.top; 
    ctx.lineTo(x,y); 
    ctx.stroke(); 
  };
  
  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 서명 지우기
  const clearCanvas = () => {
    const canvas = canvasRef.current;
    if(canvas) {
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
    let signKey = workerStep === 10 ? 'sign4' : `sign${workerStep - 6}`;
    setSignatures(prev => ({ ...prev, [signKey]: null }));
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ 서명 크기 조정
  const getCompressedSignature = () => {
    const canvas = canvasRef.current;
    const mini = document.createElement('canvas');
    mini.width = canvas.width / 2;
    mini.height = canvas.height / 2;
    const ctx = mini.getContext('2d');
    ctx.drawImage(canvas, 0, 0, mini.width, mini.height);
    return mini.toDataURL('image/png');
  };
  
  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ (근로자)서명 확인
  const saveSignatureAndNext = (signKey) => {
    const canvas = canvasRef.current;
    const blank = document.createElement('canvas'); blank.width = canvas.width; blank.height = canvas.height;
    if(canvas.toDataURL() === blank.toDataURL()) return alert("서명을 해주세요.");
    const currentSignData = getCompressedSignature(); 
    setSignatures(prev => ({ ...prev, [signKey]: currentSignData }));
    setWorkerStep(workerStep + 1);
  };

  // 4-4. 주요 헬퍼 함수 (Index.html)
  // ⭐ (근로자)서명 확인
  const finalSubmit = () => {
